# YouTube OAuth credentials (from Google Cloud Console)
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret

# Facebook Page/Reels credentials (from Meta for Developers / Graph API)
FACEBOOK_PAGE_ID=your-facebook-page-id
FACEBOOK_PAGE_ACCESS_TOKEN=your-facebook-page-access-token
# Optional: pin Graph API version used by facebook-reel-upload.py
# FACEBOOK_GRAPH_VERSION=v21.0

# Optional: override base directory (defaults to script directory)
# NSTC_BASE_DIR=/path/to/your/data
